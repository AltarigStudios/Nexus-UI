	win:_Bind(swatchStroke, "Color", "Stroke")
	local arrow = Create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0, headerH / 2), Size = UDim2.fromOffset(16, 16),
		BackgroundTransparency = 1, Font = FONT_B, TextSize = 18, Text = "›", Parent = row,
	})
	win:_Bind(arrow, "TextColor3", "SubText")
	win:_Hover(row, head)

	local PANEL_H = 154
	local panel = Create("Frame", {
		Position = UDim2.fromOffset(0, headerH), Size = UDim2.new(1, 0, 0, PANEL_H), BackgroundTransparency = 1, Parent = row,
	})
	local svBox = Create("Frame", {Position = UDim2.fromOffset(12, 4), Size = UDim2.new(1, -64, 0, 112), Parent = panel}, {Corner(6)})
	Create("Frame", {
		Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = svBox,
	}, {Corner(6), Create("UIGradient", {Transparency = NumberSequence.new(0, 1)})})
	Create("Frame", {
		Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Parent = svBox,
	}, {Corner(6), Create("UIGradient", {Rotation = 90, Transparency = NumberSequence.new(1, 0)})})
	local svCursor = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(10, 10), BackgroundTransparency = 1, ZIndex = 3, Parent = svBox,
	}, {Pill()})
	Stroke(svCursor, Color3.new(1, 1, 1), 2)
	local svHit = Create("TextButton", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 4, Parent = svBox})

	local hueBar = Create("Frame", {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 4), Size = UDim2.fromOffset(26, 112),
		BackgroundColor3 = Color3.new(1, 1, 1), Parent = panel,
	}, {Corner(6), Create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)),
			ColorSequenceKeypoint.new(1 / 6, Color3.fromHSV(1 / 6, 1, 1)),
			ColorSequenceKeypoint.new(2 / 6, Color3.fromHSV(2 / 6, 1, 1)),
			ColorSequenceKeypoint.new(3 / 6, Color3.fromHSV(3 / 6, 1, 1)),
			ColorSequenceKeypoint.new(4 / 6, Color3.fromHSV(4 / 6, 1, 1)),
			ColorSequenceKeypoint.new(5 / 6, Color3.fromHSV(5 / 6, 1, 1)),
			ColorSequenceKeypoint.new(1, Color3.fromHSV(1, 1, 1)),
		}),
	})})
	local hueCursor = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(1, 4, 0, 4), BackgroundTransparency = 1, ZIndex = 3, Parent = hueBar,
	}, {Corner(2)})
	Stroke(hueCursor, Color3.new(1, 1, 1), 2)
	local hueHit = Create("TextButton", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 4, Parent = hueBar})

	local hex = Create("TextBox", {
		Position = UDim2.fromOffset(12, 122), Size = UDim2.new(1, -24, 0, 26), ClearTextOnFocus = false,
		Font = FONT_M, TextSize = 12, Text = "", Parent = panel,
	}, {Corner(6)})
	win:_Bind(hex, "BackgroundColor3", "Elevated")
	win:_Bind(hex, "TextColor3", "Text")

	local obj = {Type = "ColorPicker", Value = color}
	local function apply(silent)
		color = Color3.fromHSV(h, s, v)
		obj.Value = color
		swatch.BackgroundColor3 = color
		svBox.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		svCursor.Position = UDim2.fromScale(s, 1 - v)
		hueCursor.Position = UDim2.fromScale(0.5, h)
		hex.Text = ToHex(color)
		if not silent then win:_Emit(obj, opts, color) end
	end
	apply(true)

	local c1 = TrackDrag(svHit, function(pos)
		s = math.clamp((pos.X - svBox.AbsolutePosition.X) / math.max(svBox.AbsoluteSize.X, 1), 0, 1)
		v = 1 - math.clamp((pos.Y - svBox.AbsolutePosition.Y) / math.max(svBox.AbsoluteSize.Y, 1), 0, 1)
		apply()
	end, self.Page, win.Maid)
	local c2 = TrackDrag(hueHit, function(pos)
		h = math.clamp((pos.Y - hueBar.AbsolutePosition.Y) / math.max(hueBar.AbsoluteSize.Y, 1), 0, 1)
		apply()
	end, self.Page, win.Maid)

	hex.FocusLost:Connect(function()
		local r, g, b = hex.Text:match("^#?(%x%x)(%x%x)(%x%x)$")
		if r then
			h, s, v = Color3.fromRGB(tonumber(r, 16), tonumber(g, 16), tonumber(b, 16)):ToHSV()
			apply()
		else
			hex.Text = ToHex(color)
		end
	end)
	head.MouseButton1Click:Connect(function()
		isOpen = not isOpen
		Tween(row, {Size = UDim2.new(1, 0, 0, isOpen and (headerH + PANEL_H) or headerH)}, EASE_SLOW)
		Tween(arrow, {Rotation = isOpen and 90 or 0})
	end)

	function obj:Set(c, silent)
		h, s, v = c:ToHSV()
		apply(silent)
	end
	function obj:_Export()
		return {math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5)}
	end
	function obj:_Import(data)
		if type(data) == "table" then self:Set(Color3.fromRGB(data[1] or 255, data[2] or 255, data[3] or 255)) end
	end
	return self:_Finish(obj, row, opts, function() c1() c2() end)
end

--══════════════════════════════════════════════════════════════════════
-- ELEMENTO: ProgressBar
--══════════════════════════════════════════════════════════════════════
function Elements:CreateProgressBar(opts)
	opts = opts or {}
	local win = self.Window
	local range = opts.Range or {0, 100}
	local min, max = range[1], range[2]
	local row, title, headerH = self:_Row(opts, 40)
	local bar = Create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0, headerH / 2), Size = UDim2.new(0.42, 0, 0, 22),
		ClipsDescendants = true, Parent = row,
	}, {Corner(6)})
	local barStroke = Stroke(bar)
	win:_Bind(bar, "BackgroundColor3", "Elevated")
	win:_Bind(barStroke, "Color", "Stroke")
	local fill = Create("Frame", {Size = UDim2.fromScale(0, 1), BackgroundTransparency = 0.55, BorderSizePixel = 0, Parent = bar})
	win:_Bind(fill, "BackgroundColor3", "Accent")
	local lbl = Create("TextLabel", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = FONT_M, TextSize = 12, ZIndex = 2, Parent = bar,
	})
	win:_Bind(lbl, "TextColor3", "Text")

	local value = math.clamp(tonumber(Pick(opts, "Default", "CurrentValue")) or min, min, max)
	local obj = {Type = "ProgressBar", Value = value}
	local function render(animate)
		local a = (max == min) and 0 or (value - min) / (max - min)
		Tween(fill, {Size = UDim2.fromScale(a, 1)}, animate and EASE_SLOW or INSTANT)
		if type(opts.Format) == "function" then
			local ok, text = pcall(opts.Format, value, a)
			lbl.Text = ok and tostring(text) or ""
		elseif opts.Suffix then
			lbl.Text = tostring(value) .. opts.Suffix
		else
			lbl.Text = string.format("%d%%", math.floor(a * 100 + 0.5))
		end
	end
	render(false)
	function obj:Set(v)
		value = math.clamp(tonumber(v) or value, min, max)
		self.Value = value
		render(true)
		self.Changed:Fire(value)
	end
	return self:_Finish(obj, row, opts)
end

