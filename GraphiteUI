--══════════════════════════════════════════════════════════════════════
-- SECCIONES Y PESTAÑAS
--══════════════════════════════════════════════════════════════════════
function Tab:CreateSection(name, sopts)
	sopts = sopts or {}
	local win = self.Window
	local sec = setmetatable({Window = win, Page = self.Page, _tab = self, _order = 0, _entries = {}}, Section)
	local holder = Create("Frame", {
		Name = "Section_" .. tostring(name), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1, LayoutOrder = self:_NextOrder(), Parent = self.Container,
	}, {List(6)})
	local header = Create("TextButton", {
		LayoutOrder = 0, Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Parent = holder,
	})
	local label = Create("TextLabel", {
		Position = UDim2.fromOffset(4, 0), Size = UDim2.new(1, -28, 1, 0), BackgroundTransparency = 1, Font = FONT_B,
		TextSize = 11, Text = string.upper(tostring(name)), TextXAlignment = LEFT, Parent = header,
	})
	win:_Bind(label, "TextColor3", "SubText")
	local content = Create("Frame", {
		LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = holder,
	}, {List(6)})
	sec.Container, sec.Frame = content, holder

	local collapsed = sopts.Collapsible == true and sopts.Collapsed == true
	if sopts.Collapsible then
		local arrow = Create("TextLabel", {
			AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -4, 0.5, 0), Size = UDim2.fromOffset(16, 16),
			BackgroundTransparency = 1, Font = FONT_B, TextSize = 16, Text = "›", Rotation = collapsed and 0 or 90, Parent = header,
		})
		win:_Bind(arrow, "TextColor3", "SubText")
		function sec:SetCollapsed(state)
			collapsed = state
			content.Visible = not state
			Tween(arrow, {Rotation = state and 0 or 90})
		end
		header.MouseButton1Click:Connect(function() sec:SetCollapsed(not collapsed) end)
		content.Visible = not collapsed
	else
		function sec:SetCollapsed() end
	end
	function sec:Set(text)
		label.Text = string.upper(tostring(text))
	end
	function sec:Destroy()
		for _, e in ipairs(self._entries) do
			local i = table.find(self._tab._entries, e)
			if i then table.remove(self._tab._entries, i) end
		end
		local j = table.find(self._tab._sections, self)
		if j then table.remove(self._tab._sections, j) end
		holder:Destroy()
	end
	table.insert(self._sections, sec)
	return sec
end

function Tab:Select() self.Window:SelectTab(self) end

function Tab:Destroy()
	local win = self.Window
	local i = table.find(win.Tabs, self)
	if i then table.remove(win.Tabs, i) end
	for _, obj in ipairs(table.clone(self._objects)) do pcall(obj.Destroy, obj) end
	self.Page:Destroy()
	self.Button:Destroy()
	if win.ActiveTab == self then
		win.ActiveTab = nil
		local nxt = win.Tabs[1]
		for _, t in ipairs(win.Tabs) do
			if not t._internal then nxt = t break end
		end
		if nxt then win:SelectTab(nxt) end
	end
end

function Window:SelectTab(tab)
	self.ActiveTab = tab
	for _, t in ipairs(self.Tabs) do
		t.Page.Visible = (t == tab)
		t._paint()
	end
	self:_ApplySearch()
	self.Events.Tab:Fire(tab)
end

function Window:CreateTab(name, icon, internal)
	local tab = setmetatable({
		Window = self, Name = name, _order = 0, _entries = {}, _sections = {}, _objects = {}, _internal = internal,
	}, Tab)
	tab._tab = tab
	self._tabOrder = (self._tabOrder or 0) + 1

	local btn = Create("TextButton", {
		Name = tostring(name), Size = UDim2.fromOffset(0, 28), AutomaticSize = Enum.AutomaticSize.X, AutoButtonColor = false,
		Text = "", LayoutOrder = internal and 9999 or self._tabOrder, Parent = self._tabBar,
	}, {Corner(14), Pad(12, 0, 12, 0), List(6, {FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, HorizontalAlignment = Enum.HorizontalAlignment.Center})})
	local btnStroke = Stroke(btn)
	local iconImg
	local iconAsset = ResolveIcon(icon)
	if iconAsset then
		iconImg = Create("ImageLabel", {
			LayoutOrder = 1, Size = UDim2.fromOffset(14, 14), BackgroundTransparency = 1, Image = iconAsset, Parent = btn,
		})
	end
	local label = Create("TextLabel", {
		LayoutOrder = 2, Size = UDim2.fromOffset(0, 16), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1,
		Font = FONT_M, TextSize = 12, Text = tostring(name), Parent = btn,
	})

	local page = Create("ScrollingFrame", {
		Name = tostring(name), Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 3, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y, Visible = false, Parent = self._content,
	}, {Pad(12, 6, 12, 14), List(8)})
	self:_Bind(page, "ScrollBarImageColor3", "Stroke")
	tab.Page, tab.Container, tab.Button = page, page, btn

	tab._paint = function()
		local th = self.Theme
		local active = self.ActiveTab == tab
		Tween(btn, {BackgroundColor3 = active and th.Accent or th.Surface})
		Tween(btnStroke, {Color = active and th.Accent or th.Stroke})
		Tween(label, {TextColor3 = active and th.AccentText or th.SubText})
		if iconImg then Tween(iconImg, {ImageColor3 = active and th.AccentText or th.SubText}) end
	end
	self:_Refresh(btn, tab._paint)
	btn.MouseEnter:Connect(function()
		if self.ActiveTab ~= tab then Tween(btn, {BackgroundColor3 = self.Theme.Hover}) end
	end)
	btn.MouseLeave:Connect(function()
		if self.ActiveTab ~= tab then Tween(btn, {BackgroundColor3 = self.Theme.Surface}) end
	end)
	btn.MouseButton1Click:Connect(function() self:SelectTab(tab) end)

	table.insert(self.Tabs, tab)
	if not internal and (not self.ActiveTab or self.ActiveTab._internal) then self:SelectTab(tab) end
	return tab
end

--══════════════════════════════════════════════════════════════════════
-- PESTAÑA INTEGRADA: AJUSTES (tema, escala, tecla, perfiles)
--══════════════════════════════════════════════════════════════════════
function Window:_BuildSettings(icon)
	local win = self
	local tab = self:CreateTab("Ajustes", icon, true)

	local ui = tab:CreateSection("Interfaz")
	local names = {}
	for n in pairs(Graphite.Themes) do table.insert(names, n) end
	table.sort(names)
	ui:CreateDropdown({
		Name = "Tema", Description = "Cambia los colores de toda la interfaz", Options = names, Default = win.ThemeName,
		Searchable = false,
		Callback = function(name)
			win:SetTheme(name)
			win:_SaveSettings()
		end,
	})
	ui:CreateSlider({
		Name = "Escala", Range = {60, 140}, Increment = 5, Suffix = "%", Default = math.floor(win._userScale * 100 + 0.5),
		Callback = function(v)
			win:SetScale(v / 100)
			win:_SaveSettings()
		end,
	})
	ui:CreateKeybind({
		Name = "Tecla de la ventana", Description = "Muestra u oculta la interfaz", Default = win.ToggleKey,
		OnChange = function(k)
			if k then win.ToggleKey = k end
			win:_SaveSettings()
		end,
	})
	ui:CreateToggle({
		Name = "Notificaciones", Default = Graphite.NotificationsEnabled,
		Callback = function(v)
			Graphite.NotificationsEnabled = v
			win:_SaveSettings()
		end,
	})

	local cfg = tab:CreateSection("Perfiles de configuración")
	local profile = win.ConfigName
	local dropdown
	local nameInput = cfg:CreateInput({
		Name = "Nombre del perfil", Default = profile, Placeholder = "Perfil",
		Callback = function(text) profile = SanitizeName(text) or profile end,
	})
	local function profiles()
		return win:ListConfigs()
	end
	dropdown = cfg:CreateDropdown({
		Name = "Perfiles guardados", Options = profiles(), Searchable = false,
		Callback = function(name)
			if name then
				profile = name
				nameInput:Set(name, true)
			end
		end,
	})
	cfg:CreateButton({
		Name = "Guardar perfil",
		Callback = function()
			win:SaveConfig(profile)
			dropdown:Refresh(profiles())
			Graphite:Notify({Title = "Perfil guardado", Content = profile, Type = "success", Duration = 2.5})
		end,
	})
	cfg:CreateButton({
		Name = "Cargar perfil",
		Callback = function()
			local ok, err = win:LoadConfig(profile)
			Graphite:Notify({
				Title = ok and "Perfil cargado" or "No se pudo cargar",
				Content = ok and profile or tostring(err), Type = ok and "success" or "error", Duration = 2.5,
			})
		end,
	})
	cfg:CreateButton({
		Name = "Eliminar perfil",
		Callback = function()
			win:Confirm("Eliminar perfil", "¿Eliminar '" .. tostring(profile) .. "'? No se puede deshacer.", function()
				win:DeleteConfig(profile)
				dropdown:Refresh(profiles())
			end)
		end,
	})
	cfg:CreateToggle({
		Name = "Cargar este perfil al iniciar", Default = win.Settings.AutoLoad ~= nil and win.Settings.AutoLoad == profile,
		Callback = function(v)
			win.Settings.AutoLoad = v and profile or nil
			win:_SaveSettings()
		end,
	})

	local io = tab:CreateSection("Importar / exportar")
	local area = io:CreateTextArea({Name = "JSON de configuración", Height = 70, Placeholder = "Pega aquí un JSON para importarlo"})
	io:CreateButton({
		Name = "Exportar configuración actual",
		Callback = function()
			local json = win:ExportConfig()
			area:Set(json, true)
			local clip = Global("setclipboard") or Global("toclipboard")
			if clip then pcall(clip, json) end
			Graphite:Notify({
				Title = "Configuración exportada", Content = clip and "Copiada al portapapeles" or "Copia el texto del cuadro",
				Type = "success", Duration = 2.5,
			})
		end,
	})
	io:CreateButton({
		Name = "Importar desde el cuadro",
		Callback = function()
			local ok, err = win:ImportConfig(area:Get())
			Graphite:Notify({
				Title = ok and "Configuración importada" or "Importación fallida",
				Content = ok and "" or tostring(err), Type = ok and "success" or "error", Duration = 2.5,
			})
		end,
	})

	local about = tab:CreateSection("Acerca de")
	about:CreateParagraph({
		Title = "Graphite UI v" .. Graphite.Version,
		Content = "Almacenamiento: " .. (FS.IsPersistent() and "archivos del ejecutor" or "memoria (se pierde al salir)")
			.. "\nCarpeta: " .. win.Folder,
	})
	return tab
end

