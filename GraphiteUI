--══════════════════════════════════════════════════════════════════════
-- ELEMENTO: Log (consola de solo lectura)
--══════════════════════════════════════════════════════════════════════
function Elements:CreateLog(opts)
	opts = opts or {}
	local win = self.Window
	local h = opts.Height or 150
	local maxLines = opts.MaxLines or 200
	local hasTitle = opts.Name ~= nil
	local row, title, headerH = self:_Row(opts, hasTitle and 30 or 0)
	title.Visible = hasTitle
	row.Size = UDim2.new(1, 0, 0, headerH + h + 12)
	local scroll = Create("ScrollingFrame", {
		Position = UDim2.fromOffset(12, headerH + (hasTitle and 0 or 12)), Size = UDim2.new(1, -24, 0, h - (hasTitle and 0 or 12)),
		BorderSizePixel = 0, ScrollBarThickness = 3, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Parent = row,
	}, {Corner(6), Pad(8, 6, 8, 6), List(2)})
	win:_Bind(scroll, "BackgroundColor3", "Background")
	win:_Bind(scroll, "ScrollBarImageColor3", "Stroke")

	local lines = {}
	local function color(kind)
		local th = win.Theme
		if kind == "success" then return th.Success end
		if kind == "warn" then return th.Warning end
		if kind == "error" then return th.Danger end
		return th.SubText
	end
	win:_Refresh(row, function()
		for _, l in ipairs(lines) do l.label.TextColor3 = color(l.kind) end
	end)

	local obj = {Type = "Log"}
	function obj:Log(text, kind)
		local label = Create("TextLabel", {
			LayoutOrder = #lines + 1, Size = UDim2.new(1, 0, 0, 14), AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1, Font = FONT, TextSize = 11, TextXAlignment = LEFT, TextYAlignment = Enum.TextYAlignment.Top,
			TextWrapped = true, TextColor3 = color(kind), Text = string.format("[%s] %s", os.date("%H:%M:%S"), tostring(text)),
			Parent = scroll,
		})
		table.insert(lines, {label = label, kind = kind})
		if #lines > maxLines then
			local old = table.remove(lines, 1)
			old.label:Destroy()
		end
		task.defer(function()
			if scroll.Parent then scroll.CanvasPosition = Vector2.new(0, 1e6) end
		end)
	end
	function obj:Clear()
		for _, l in ipairs(lines) do l.label:Destroy() end
		table.clear(lines)
	end
	function obj:Get()
		local out = {}
		for _, l in ipairs(lines) do table.insert(out, l.label.Text) end
		return out
	end
	return self:_Finish(obj, row, opts)
end

