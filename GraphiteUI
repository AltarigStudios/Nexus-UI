function Window:SetVisible(state)
	if self.Visible == state then return end
	self.Visible = state
	self._tip.Visible = false
	if state then
		self.Main.Visible = true
		self._animNV.Value = 0.9
		Tween(self._animNV, {Value = 1}, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
	else
		local t = Tween(self._animNV, {Value = 0.9}, TweenInfo.new(0.14))
		t.Completed:Once(function()
			if not self.Visible then self.Main.Visible = false end
		end)
	end
	self.Events.Visibility:Fire(state)
end

function Window:Toggle() self:SetVisible(not self.Visible) end

function Window:SetMinimized(state)
	if self.Minimized == state then return end
	self.Minimized = state
	self._grip.Visible = not state
	if state then
		self._fullSize = self.Main.Size
		Tween(self.Main, {Size = UDim2.new(self._fullSize.X.Scale, self._fullSize.X.Offset, 0, 46)}, EASE_SLOW)
		task.delay(0.22, function() if self.Minimized then self._body.Visible = false end end)
	else
		self._body.Visible = true
		Tween(self.Main, {Size = self._fullSize}, EASE_SLOW)
	end
end

function Window:Dialog(opts)
	opts = opts or {}
	local th = self.Theme
	local overlay = Create("TextButton", {
		Name = "Dialog", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 100, Parent = self.Main,
	})
	Tween(overlay, {BackgroundTransparency = 0.45})
	local card = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(300, 0),
		AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = th.Surface, Parent = overlay,
	}, {Corner(10), Pad(16, 14, 16, 14), List(10)})
	Stroke(card, th.Stroke)
	Create("TextLabel", {
		LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 18), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
		Font = FONT_B, TextSize = 15, TextColor3 = th.Text, TextXAlignment = LEFT, TextWrapped = true,
		Text = opts.Title or "Aviso", Parent = card,
	})
	if opts.Content and opts.Content ~= "" then
		Create("TextLabel", {
			LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 14), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
			Font = FONT, TextSize = 12, TextColor3 = th.SubText, TextXAlignment = LEFT, TextYAlignment = Enum.TextYAlignment.Top,
			TextWrapped = true, Text = opts.Content, Parent = card,
		})
	end
	local closed = false
	local function close()
		if closed then return end
		closed = true
		Tween(overlay, {BackgroundTransparency = 1})
		task.delay(0.15, function() overlay:Destroy() end)
	end
	local buttons = opts.Buttons or {{Name = "Aceptar", Primary = true}}
	local row = Create("Frame", {
		LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, Parent = card,
	}, {List(8, {FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, VerticalAlignment = Enum.VerticalAlignment.Center})})
	for i, b in ipairs(buttons) do
		local primary = b.Primary == true
		local btn = Create("TextButton", {
			LayoutOrder = i, Size = UDim2.fromOffset(0, 30), AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = primary and th.Accent or th.Elevated, AutoButtonColor = false, Font = FONT_M, TextSize = 12,
			TextColor3 = primary and th.AccentText or th.Text, Text = b.Name or "OK", Parent = row,
		}, {Corner(6), Pad(14, 0, 14, 0)})
		btn.MouseButton1Click:Connect(function()
			close()
			Safe(b.Callback)
		end)
	end
	return {Close = close}
end

function Window:Confirm(title, content, onYes, onNo)
	return self:Dialog({
		Title = title, Content = content,
		Buttons = {
			{Name = "Cancelar", Callback = onNo},
			{Name = "Confirmar", Primary = true, Callback = onYes},
		},
	})
end

function Window:Destroy()
	if self.Destroyed then return end
	self.Destroyed = true
	self.Events.Destroying:Fire()
	self.Maid:Clean()
	for flag, obj in pairs(self.Flags) do
		if Graphite.Flags[flag] == obj then Graphite.Flags[flag] = nil end
	end
	table.clear(self.Flags)
	if self.Gui then self.Gui:Destroy() end
	local i = table.find(Graphite._windows, self)
	if i then table.remove(Graphite._windows, i) end
end

function Graphite:Destroy()
	for i = #self._windows, 1, -1 do self._windows[i]:Destroy() end
end

function Graphite:SetVisibility(state)
	for _, w in ipairs(self._windows) do w:SetVisible(state) end
end

function Graphite:IsVisible()
	local w = self._windows[1]
	return w ~= nil and w.Visible
end

function Graphite:LoadConfiguration()
	for _, w in ipairs(self._windows) do w:LoadConfig() end
end

