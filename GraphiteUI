		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = self:_NextOrder(), Parent = self.Container,
	}, {Corner(7), Pad(14, 11, 14, 11), List(4)})
