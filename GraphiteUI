		Font = FONT_B, TextSize = 13, Text = tostring(opts.Title or ""), TextXAlignment = LEFT, TextWrapped = true, Parent = frame,
	})
	win:_Bind(t, "TextColor3", "Text")
	local c = Create("TextLabel", {
		LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 14), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
		Font = FONT, TextSize = 12, Text = tostring(opts.Content or ""), TextXAlignment = LEFT,
		TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, Parent = frame,
	})
	win:_Bind(c, "TextColor3", "SubText")
