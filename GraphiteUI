--══════════════════════════════════════════════════════════════════════
-- ELEMENTO: Toggle
--══════════════════════════════════════════════════════════════════════
function Elements:CreateToggle(opts)
	opts = opts or {}
	local win = self.Window
	local row, title, headerH = self:_Row(opts, 40)
	local state = Pick(opts, "Default", "CurrentValue") == true
	local track = Create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0, headerH / 2), Size = UDim2.fromOffset(40, 22), Parent = row,
	}, {Pill()})
	local trackStroke = Stroke(track)
	local knob = Create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0), Size = UDim2.fromOffset(16, 16), Parent = track,
	}, {Pill()})
	local hit = Create("TextButton", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 2, Parent = row,
	})
	win:_Hover(row, hit)

	local obj = {Type = "Toggle", Value = state}
	local function render(animate)
		local th, info = win.Theme, animate and EASE or INSTANT
		Tween(track, {BackgroundColor3 = state and th.Accent or th.Elevated}, info)
		Tween(trackStroke, {Color = state and th.Accent or th.Stroke}, info)
		Tween(knob, {
			Position = state and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
			BackgroundColor3 = state and th.AccentText or th.SubText,
		}, info)
	end
	win:_Refresh(row, function() render(false) end)

	function obj:Set(value, silent)
		state = value == true
		self.Value = state
		render(true)
		if not silent then win:_Emit(self, opts, state) end
	end
	function obj:_Export() return state end
	function obj:_Import(data) self:Set(data == true) end
	hit.MouseButton1Click:Connect(function() obj:Set(not state) end)
	return self:_Finish(obj, row, opts)
end

--══════════════════════════════════════════════════════════════════════
-- ELEMENTO: Slider (barra con relleno, estilo Rayfield)
--══════════════════════════════════════════════════════════════════════
function Elements:CreateSlider(opts)
	opts = opts or {}
	local win = self.Window
	local range = opts.Range or {0, 100}
	local min, max = range[1], range[2]
	local inc = opts.Increment or 1
	local suffix = opts.Suffix or ""
	local decimals = 0
	do
		local s = tostring(inc)
		local dot = s:find("%.")
		if dot then decimals = #s - dot end
	end
	local function snap(v)
		v = math.clamp(v, min, max)
		v = min + math.floor((v - min) / inc + 0.5) * inc
		return tonumber(string.format("%." .. decimals .. "f", math.clamp(v, min, max)))
	end

	local row, title, headerH = self:_Row(opts, 44)
	local bar = Create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0, headerH / 2), Size = UDim2.new(0.42, 0, 0, 24),
		ClipsDescendants = true, Parent = row,
	}, {Corner(6)})
	local barStroke = Stroke(bar)
	win:_Bind(bar, "BackgroundColor3", "Elevated")
	win:_Bind(barStroke, "Color", "Stroke")
	local fill = Create("Frame", {Size = UDim2.fromScale(0, 1), BackgroundTransparency = 0.55, BorderSizePixel = 0, Parent = bar})
	win:_Bind(fill, "BackgroundColor3", "Accent")
	local valueLabel = Create("TextLabel", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = FONT_M, TextSize = 12, ZIndex = 2, Parent = bar,
	})
	win:_Bind(valueLabel, "TextColor3", "Text")
	local hit = Create("TextButton", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 3, Parent = bar,
	})

	local value = snap(tonumber(Pick(opts, "Default", "CurrentValue")) or min)
	local obj = {Type = "Slider", Value = value}
	local function render(animate)
		local a = (max == min) and 0 or (value - min) / (max - min)
		Tween(fill, {Size = UDim2.fromScale(a, 1)}, animate and TweenInfo.new(0.08) or INSTANT)
		valueLabel.Text = tostring(value) .. suffix
	end
	render(false)

	function obj:Set(v, silent)
		v = snap(tonumber(v) or min)
		local changed = v ~= value
		value = v
		self.Value = v
		render(true)
		if changed and not silent then win:_Emit(self, opts, v) end
	end
	function obj:_Export() return value end
	function obj:_Import(data) self:Set(data) end

	local cleanup = TrackDrag(hit, function(pos)
		local rel = math.clamp((pos.X - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		obj:Set(min + (max - min) * rel)
	end, self.Page, win.Maid)
	return self:_Finish(obj, row, opts, cleanup)
end

--══════════════════════════════════════════════════════════════════════
-- ELEMENTO: Stepper (número con - / +)
--══════════════════════════════════════════════════════════════════════
function Elements:CreateStepper(opts)
	opts = opts or {}
	local win = self.Window
	local range = opts.Range or {-1e9, 1e9}
	local min, max = range[1], range[2]
	local step = opts.Increment or 1
	local row, title, headerH = self:_Row(opts, 40)
	local value = math.clamp(tonumber(Pick(opts, "Default", "CurrentValue")) or math.max(min, 0), min, max)
	local holder = Create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0, headerH / 2), Size = UDim2.fromOffset(120, 26),
		BackgroundTransparency = 1, Parent = row,
	})
	local function mkButton(text, x)
		local b = Create("TextButton", {
			Position = UDim2.fromOffset(x, 0), Size = UDim2.fromOffset(26, 26), AutoButtonColor = false,
			Font = FONT_B, TextSize = 16, Text = text, Parent = holder,
		}, {Corner(6)})
		local s = Stroke(b)
		win:_Bind(b, "BackgroundColor3", "Elevated")
		win:_Bind(b, "TextColor3", "Text")
		win:_Bind(s, "Color", "Stroke")
		return b
	end
	local minus, plus = mkButton("–", 0), mkButton("+", 94)
	local box = Create("TextBox", {
		Position = UDim2.fromOffset(30, 0), Size = UDim2.fromOffset(60, 26), ClearTextOnFocus = false,
		Font = FONT_M, TextSize = 12, Text = "", Parent = holder,
	}, {Corner(6)})
	win:_Bind(box, "BackgroundColor3", "Background")
	win:_Bind(box, "TextColor3", "Text")

	local obj = {Type = "Stepper", Value = value}
	function obj:Set(v, silent)
		v = math.clamp(tonumber(v) or value, min, max)
		local changed = v ~= value
		value = v
		self.Value = v
		box.Text = tostring(v)
		if changed and not silent then win:_Emit(self, opts, v) end
	end
	box.Text = tostring(value)
	box.FocusLost:Connect(function() obj:Set(box.Text) box.Text = tostring(value) end)

	local function holdRepeat(btn, dir)
		local token = 0
		btn.InputBegan:Connect(function(input)
			if input.UserInputType == MOUSE1 or input.UserInputType == TOUCH then
				token = token + 1
				local mine = token
				obj:Set(value + dir * step)
				task.spawn(function()
					task.wait(0.4)
					while mine == token and btn.Parent do
						obj:Set(value + dir * step)
						task.wait(0.06)
					end
				end)
			end
		end)
		btn.InputEnded:Connect(function(input)
			if input.UserInputType == MOUSE1 or input.UserInputType == TOUCH then token = token + 1 end
		end)
		btn.MouseLeave:Connect(function() token = token + 1 end)
	end
	holdRepeat(minus, -1)
	holdRepeat(plus, 1)

	function obj:_Export() return value end
	function obj:_Import(data) self:Set(data) end
	return self:_Finish(obj, row, opts)
end

--══════════════════════════════════════════════════════════════════════
-- ELEMENTO: Input
--══════════════════════════════════════════════════════════════════════
function Elements:CreateInput(opts)
	opts = opts or {}
	local win = self.Window
	local row, title, headerH = self:_Row(opts, 40)
	local box = Create("TextBox", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0, headerH / 2), Size = UDim2.fromOffset(160, 26),
		ClearTextOnFocus = false, ClipsDescendants = true, Text = tostring(Pick(opts, "Default", "CurrentValue") or ""),
		PlaceholderText = Pick(opts, "Placeholder", "PlaceholderText") or "Escribe aquí...", Font = FONT, TextSize = 12,
		TextXAlignment = LEFT, Parent = row,
	}, {Corner(6), Pad(9, 0, 9, 0)})
	local stroke = Stroke(box)
	win:_Bind(box, "BackgroundColor3", "Elevated")
	win:_Bind(box, "TextColor3", "Text")
	win:_Bind(box, "PlaceholderColor3", "SubText")
	win:_Bind(stroke, "Color", "Stroke")

	local obj = {Type = "Input", Value = box.Text}
	local function clean()
		local txt = box.Text
		if opts.NumbersOnly then txt = (txt:gsub("[^%d%.%-]", "")) end
		if opts.MaxLength then txt = txt:sub(1, opts.MaxLength) end
		if txt ~= box.Text then box.Text = txt end
		return txt
	end
	box.Focused:Connect(function() Tween(stroke, {Color = win.Theme.Accent}) end)
	box.FocusLost:Connect(function(enter)
		Tween(stroke, {Color = win.Theme.Stroke})
		local txt = clean()
		obj.Value = txt
		win:_Emit(obj, opts, txt, enter)
		if Pick(opts, "ClearOnLost", "RemoveTextAfterFocusLost") then box.Text = "" end
	end)
	if opts.Live then
		box:GetPropertyChangedSignal("Text"):Connect(function()
			local txt = clean()
			obj.Value = txt
			win:_Emit(obj, opts, txt, false)
		end)
	end
	function obj:Set(text, silent)
		box.Text = tostring(text)
		self.Value = box.Text
		if not silent then win:_Emit(self, opts, box.Text, false) end
	end
	function obj:_Export() return box.Text end
	function obj:_Import(data) self:Set(data) end
	return self:_Finish(obj, row, opts)
end

