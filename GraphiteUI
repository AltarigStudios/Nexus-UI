-- CREAR VENTANA
--══════════════════════════════════════════════════════════════════════
function Graphite:CreateWindow(opts)
	opts = opts or {}
	local saving = opts.ConfigurationSaving
	local baseName = SanitizeName(opts.Name) or "Graphite"
	local folder = (saving and saving.FolderName and SanitizeName(saving.FolderName)) or ("Graphite/" .. baseName)

	-- ajustes guardados
	local settings = {}
	local rawSettings = FS.Read(folder .. "/Settings.json")
	if rawSettings then
		local ok, decoded = pcall(function() return HttpService:JSONDecode(rawSettings) end)
		if ok and type(decoded) == "table" then settings = decoded end
	end
	local themeName = settings.Theme
	if opts.ForceTheme or not (themeName and self.Themes[themeName]) then themeName = opts.Theme or "Graphite" end
	local theme = self.Themes[themeName] or Themes.Graphite
	if not self.Themes[themeName] then themeName = "Graphite" end
	if settings.Notifications == false then self.NotificationsEnabled = false end

	-- sistema de clave (bloquea hasta validar)
	local keyCfg = opts.KeySettings
	if opts.KeySystem == true or (type(opts.KeySystem) == "table" and opts.KeySystem.Enabled ~= false) then
		keyCfg = type(opts.KeySystem) == "table" and opts.KeySystem or keyCfg or {}
		self:_RunKeySystem(keyCfg, theme, folder)
	end

	local win = setmetatable({
		Name = baseName, Theme = theme, ThemeName = themeName, Flags = {}, Tabs = {}, Maid = Maid.new(),
		ToggleKey = ToKeyCode(settings.ToggleKey) or opts.ToggleKey or Enum.KeyCode.RightShift,
		Saving = saving, Folder = folder, Settings = settings,
		ConfigName = SanitizeName(saving and saving.FileName) or "Default",
		Visible = false, Minimized = false, _ready = false, _query = "",
		_userScale = math.clamp(tonumber(settings.Scale) or 1, 0.6, 1.4),
		_bindings = {}, _refreshers = {},
		Events = {
			Visibility = Signal.new(), Theme = Signal.new(), Tab = Signal.new(),
			ElementChanged = Signal.new(), Destroying = Signal.new(),
		},
	}, Window)
	Graphite.CurrentTheme = theme
	table.insert(Graphite._windows, win)

	local pg = LocalPlayer:WaitForChild("PlayerGui")
	local guiName = "Graphite_" .. baseName
	local old = pg:FindFirstChild(guiName)
	if old then old:Destroy() end
	local gui = Create("ScreenGui", {
		Name = guiName, ResetOnSpawn = false, DisplayOrder = 100, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = pg,
	})
	win.Gui = gui

	local isTouch = self:IsMobile()
	local size = opts.Size or (isTouch and UDim2.fromOffset(440, 310) or UDim2.fromOffset(520, 420))

	local main = Create("Frame", {
		Name = "Main", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = size,
		ClipsDescendants = true, Visible = false, Parent = gui,
	}, {Corner(10)})
	local mainStroke = Stroke(main)
	win:_Bind(main, "BackgroundColor3", "Background")
	win:_Bind(mainStroke, "Color", "Stroke")
	win.Main = main

	-- escala (animación × escala del usuario)
	win._scale = Create("UIScale", {Parent = main})
	win._animNV = Create("NumberValue", {Value = 1})
	win.Maid:Give(win._animNV)
	win._applyScale = function() win._scale.Scale = win._animNV.Value * win._userScale end
	win.Maid:Give(win._animNV.Changed:Connect(win._applyScale))
	win._applyScale()

	-- barra superior
	local TOP_H, TAB_H = 46, 42
	local top = Create("Frame", {Name = "Topbar", Size = UDim2.new(1, 0, 0, TOP_H), BackgroundTransparency = 1, Parent = main})
	local topBg = Create("Frame", {Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, Parent = top}, {Corner(10)})
	local topPatch = Create("Frame", {
		AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 10), BorderSizePixel = 0, Parent = top,
	})
	local topLine = Create("Frame", {
		AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 1), BorderSizePixel = 0, Parent = top,
	})
	win:_Bind(topBg, "BackgroundColor3", "Topbar")
	win:_Bind(topPatch, "BackgroundColor3", "Topbar")
	win:_Bind(topLine, "BackgroundColor3", "Stroke")

	local titleHolder = Create("Frame", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(16, 0), Size = UDim2.new(1, -130, 1, 0), Parent = top,
	}, {List(8, {FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center})})
	local winIcon = ResolveIcon(opts.Icon)
	if winIcon then
		Create("ImageLabel", {
			LayoutOrder = 0, Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1, Image = winIcon, Parent = titleHolder,
		})
	end
	local titleLbl = Create("TextLabel", {
		LayoutOrder = 1, Size = UDim2.fromOffset(0, 18), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1,
		Font = FONT_B, TextSize = 15, Text = tostring(opts.Name or "Graphite"), Parent = titleHolder,
	})
	win:_Bind(titleLbl, "TextColor3", "Text")
	if opts.Subtitle then
		local sub = Create("TextLabel", {
			LayoutOrder = 2, Size = UDim2.fromOffset(0, 18), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1,
			Font = FONT, TextSize = 12, Text = tostring(opts.Subtitle), Parent = titleHolder,
		})
		win:_Bind(sub, "TextColor3", "SubText")
	end

	local controls = Create("Frame", {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 0), Size = UDim2.new(0, 108, 1, 0),
		BackgroundTransparency = 1, Parent = top,
	}, {List(4, {FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, VerticalAlignment = Enum.VerticalAlignment.Center})})
	local function ControlButton(order, text, onClick)
		local b = Create("TextButton", {
			LayoutOrder = order, Size = UDim2.fromOffset(30, 30), BackgroundTransparency = 1, AutoButtonColor = false,
			Font = FONT_B, TextSize = 19, Text = text, Parent = controls,
		}, {Corner(7)})
		win:_Bind(b, "TextColor3", "SubText")
		b.MouseEnter:Connect(function()
			b.BackgroundColor3 = win.Theme.Elevated
			Tween(b, {BackgroundTransparency = 0})
		end)
		b.MouseLeave:Connect(function() Tween(b, {BackgroundTransparency = 1}) end)
		b.MouseButton1Click:Connect(onClick)
		return b
	end
	local searchBtn = ControlButton(1, "", function() win:SetSearchOpen(not win._searchOpen) end)
	local ring = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, -1, 0.5, -1), Size = UDim2.fromOffset(11, 11),
		BackgroundTransparency = 1, Parent = searchBtn,
	}, {Pill()})
	local ringStroke = Stroke(ring, nil, 2)
	local handle = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 6, 0.5, 6), Size = UDim2.fromOffset(6, 2),
		Rotation = 45, BorderSizePixel = 0, Parent = searchBtn,
	})
	win:_Bind(ringStroke, "Color", "SubText")
	win:_Bind(handle, "BackgroundColor3", "SubText")
	ControlButton(2, "–", function() win:SetMinimized(not win.Minimized) end)
	ControlButton(3, "×", function()
		win:SetVisible(false)
		Graphite:Notify({
			Title = "Interfaz oculta", Content = "Pulsa " .. win.ToggleKey.Name .. " para volver a abrirla.", Duration = 3,
		})
	end)
	MakeDraggable(top, main, win.Maid)

	-- cuerpo: búsqueda + pestañas + contenido
	local body = Create("Frame", {
		Name = "Body", Position = UDim2.fromOffset(0, TOP_H), Size = UDim2.new(1, 0, 1, -TOP_H),
		BackgroundTransparency = 1, ClipsDescendants = true, Parent = main,
	})
	win._body = body

	local searchHolder = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1, ClipsDescendants = true, Parent = body,
	})
	local searchFrame = Create("Frame", {
		Position = UDim2.fromOffset(12, 8), Size = UDim2.new(1, -24, 0, 28), Parent = searchHolder,
	}, {Corner(7)})
	local searchStroke = Stroke(searchFrame)
	win:_Bind(searchFrame, "BackgroundColor3", "Surface")
	win:_Bind(searchStroke, "Color", "Stroke")
	local searchBox = Create("TextBox", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ClearTextOnFocus = false, Text = "",
		PlaceholderText = "Buscar en esta pestaña...", Font = FONT, TextSize = 12, TextXAlignment = LEFT, Parent = searchFrame,
	}, {Pad(10, 0, 10, 0)})
	win:_Bind(searchBox, "TextColor3", "Text")
	win:_Bind(searchBox, "PlaceholderColor3", "SubText")
	win._searchBox = searchBox
	searchBox:GetPropertyChangedSignal("Text"):Connect(function()
		win._query = searchBox.Text:lower()
		win:_ApplySearch()
	end)

	win._tabBar = Create("ScrollingFrame", {
		Name = "Tabs", Size = UDim2.new(1, 0, 0, TAB_H), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 0, ScrollingDirection = Enum.ScrollingDirection.X, CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.X, Parent = body,
	}, {Pad(12, 0, 12, 0), List(6, {FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center})})
	win._tabBar.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			local bar = win._tabBar
			local maxX = math.max(0, bar.AbsoluteCanvasSize.X - bar.AbsoluteWindowSize.X)
			bar.CanvasPosition = Vector2.new(math.clamp(bar.CanvasPosition.X - input.Position.Z * 40, 0, maxX), 0)
		end
	end)

	win._content = Create("Frame", {
		Name = "Content", Size = UDim2.new(1, 0, 1, -TAB_H), BackgroundTransparency = 1, ClipsDescendants = true, Parent = body,
	})
	win._noResults = Create("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 40), Size = UDim2.fromOffset(240, 20),
		BackgroundTransparency = 1, Font = FONT_M, TextSize = 12, Text = "Sin resultados", Visible = false, Parent = win._content,
	})
	win:_Bind(win._noResults, "TextColor3", "SubText")

	-- la barra de búsqueda desplaza pestañas y contenido
	win._searchNV = Create("NumberValue", {Value = 0})
	win.Maid:Give(win._searchNV)
	local function relayout()
		local sh = win._searchNV.Value
		searchHolder.Size = UDim2.new(1, 0, 0, sh)
		win._tabBar.Position = UDim2.fromOffset(0, sh)
		win._content.Position = UDim2.fromOffset(0, sh + TAB_H)
		win._content.Size = UDim2.new(1, 0, 1, -(sh + TAB_H))
	end
	win.Maid:Give(win._searchNV.Changed:Connect(relayout))

	-- tooltip
	local tip = Create("Frame", {
		Visible = false, Size = UDim2.fromOffset(0, 0), AutomaticSize = Enum.AutomaticSize.XY, ZIndex = 200, Parent = gui,
	}, {Corner(6), Pad(9, 6, 9, 6)})
	local tipStroke = Stroke(tip)
	win:_Bind(tip, "BackgroundColor3", "Elevated")
	win:_Bind(tipStroke, "Color", "Stroke")
	win._tip = tip
	win._tipLabel = Create("TextLabel", {
		Size = UDim2.fromOffset(0, 0), AutomaticSize = Enum.AutomaticSize.XY, BackgroundTransparency = 1, Font = FONT,
		TextSize = 12, TextWrapped = true, TextXAlignment = LEFT, ZIndex = 201, Parent = tip,
	}, {Create("UISizeConstraint", {MaxSize = Vector2.new(240, math.huge)})})
	win:_Bind(win._tipLabel, "TextColor3", "Text")

	-- redimensionar
	local grip = Create("TextButton", {
		AnchorPoint = Vector2.new(1, 1), Position = UDim2.fromScale(1, 1), Size = UDim2.fromOffset(20, 20),
		BackgroundTransparency = 1, Text = "◢", Font = FONT, TextSize = 10, TextTransparency = 0.4, ZIndex = 20, Parent = main,
	})
	win:_Bind(grip, "TextColor3", "SubText")
	win._grip = grip
	do
		local resizing, startMouse, startSize, startPos = false, nil, nil, nil
		win.Maid:Give(grip.InputBegan:Connect(function(input)
			if input.UserInputType == MOUSE1 or input.UserInputType == TOUCH then
				resizing = true
				startMouse, startSize, startPos = input.Position, main.Size, main.Position
			end
		end))
		win.Maid:Give(UserInputService.InputChanged:Connect(function(input)
			if resizing and (input.UserInputType == MOVE or input.UserInputType == TOUCH) then
				local sc = win._scale.Scale
				local d = (input.Position - startMouse) / sc
				local w = math.clamp(startSize.X.Offset + d.X, 420, 920)
				local h = math.clamp(startSize.Y.Offset + d.Y, 280, 680)
				local dw, dh = w - startSize.X.Offset, h - startSize.Y.Offset
				main.Size = UDim2.fromOffset(w, h)
				main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + dw * sc / 2, startPos.Y.Scale, startPos.Y.Offset + dh * sc / 2)
			end
		end))
		win.Maid:Give(UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == MOUSE1 or input.UserInputType == TOUCH then resizing = false end
		end))
	end

	-- tecla de mostrar/ocultar
	win.Maid:Give(UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and win._ready and input.KeyCode == win.ToggleKey then win:Toggle() end
	end))

	-- botón flotante en móviles
	if isTouch then
		local fab = Create("TextButton", {
			Position = UDim2.fromOffset(12, 64), Size = UDim2.fromOffset(42, 42), AutoButtonColor = false, Font = FONT_B,
			TextSize = 18, Text = "G", ZIndex = 50, Parent = gui,
		}, {Pill()})
		local fabStroke = Stroke(fab)
		win:_Bind(fab, "BackgroundColor3", "Surface")
		win:_Bind(fab, "TextColor3", "Text")
		win:_Bind(fabStroke, "Color", "Stroke")
		fab.MouseButton1Click:Connect(function() if win._ready then win:Toggle() end end)
	end

	-- pestaña de ajustes
	if opts.SettingsTab ~= false then win:_BuildSettings(opts.SettingsIcon) end

	-- pantalla de carga y entrada
	local function reveal()
		win._ready = true
		win:SetVisible(true)
	end
	if opts.Loading == false then
		reveal()
	else
		local dur = opts.LoadingDuration or 1.3
		local group = Create("CanvasGroup", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(320, 118),
			GroupTransparency = 1, Parent = gui,
		}, {Corner(12)})
		Stroke(group)
		win:_Bind(group, "BackgroundColor3", "Background")
		win:_Bind(group:FindFirstChildOfClass("UIStroke"), "Color", "Stroke")
		local l1 = Create("TextLabel", {
			Position = UDim2.fromOffset(20, 22), Size = UDim2.new(1, -40, 0, 24), BackgroundTransparency = 1, Font = FONT_B,
			TextSize = 20, Text = tostring(opts.LoadingTitle or opts.Name or "Graphite"), TextXAlignment = LEFT, Parent = group,
		})
		win:_Bind(l1, "TextColor3", "Text")
		local l2 = Create("TextLabel", {
			Position = UDim2.fromOffset(20, 50), Size = UDim2.new(1, -40, 0, 16), BackgroundTransparency = 1, Font = FONT,
			TextSize = 12, Text = tostring(opts.LoadingSubtitle or "Cargando interfaz..."), TextXAlignment = LEFT, Parent = group,
		})
		win:_Bind(l2, "TextColor3", "SubText")
		local track = Create("Frame", {
			Position = UDim2.new(0, 20, 1, -26), Size = UDim2.new(1, -40, 0, 4), BorderSizePixel = 0, Parent = group,
		}, {Pill()})
		win:_Bind(track, "BackgroundColor3", "Elevated")
		local fill = Create("Frame", {Size = UDim2.fromScale(0, 1), BorderSizePixel = 0, Parent = track}, {Pill()})
		win:_Bind(fill, "BackgroundColor3", "Accent")
		Tween(group, {GroupTransparency = 0}, TweenInfo.new(0.3))
		Tween(fill, {Size = UDim2.fromScale(1, 1)}, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut))
		task.delay(dur + 0.15, function()
			if win.Destroyed then return end
			local t = Tween(group, {GroupTransparency = 1}, TweenInfo.new(0.3))
			t.Completed:Once(function() group:Destroy() end)
			reveal()
		end)
	end

	return win
end

