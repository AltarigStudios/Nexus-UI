local function ResolveIcon(icon)
	if icon == nil then return nil end
	if type(icon) == "number" then return "rbxassetid://" .. icon end
	if type(icon) == "string" then
		local reg = Graphite.Icons[icon]
		if reg ~= nil then return ResolveIcon(reg) end
		if icon:find("rbxasset") or icon:find("^https?://") then return icon end
		if tonumber(icon) then return "rbxassetid://" .. icon end
	end
	return nil
end

function Graphite:RegisterTheme(name, theme)
	for k, v in pairs(Themes.Graphite) do
		if theme[k] == nil then theme[k] = v end
	end
	self.Themes[name] = theme
end

function Graphite:RegisterIcon(name, asset) self.Icons[name] = asset end

function Graphite:RegisterElement(name, builder)
	Elements[name] = builder
end

function Graphite:GetFlag(flag)
	local o = self.Flags[flag]
	return o and o:Get() or nil
end

function Graphite:SetFlag(flag, value)
	local o = self.Flags[flag]
	if o and o.Set then o:Set(value) return true end
	return false
end

function Graphite:IsMobile()
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

