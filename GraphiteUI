local notifyHost, notifyCount = nil, 0

local function GetNotifyHost()
	if notifyHost and notifyHost.Parent then return notifyHost end
	local pg = LocalPlayer:WaitForChild("PlayerGui")
	local gui = pg:FindFirstChild("GraphiteNotifications") or Create("ScreenGui", {
		Name = "GraphiteNotifications", ResetOnSpawn = false, DisplayOrder = 1000,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = pg,
	})
	notifyHost = gui:FindFirstChild("Holder") or Create("Frame", {
		Name = "Holder", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16),
		Size = UDim2.new(0, 290, 1, -32), BackgroundTransparency = 1, Parent = gui,
	}, {List(8, {VerticalAlignment = Enum.VerticalAlignment.Bottom})})
	return notifyHost
end

function Graphite:Notify(opts)
	if type(opts) ~= "table" then opts = {Title = "Graphite", Content = tostring(opts)} end
	if not self.NotificationsEnabled and not opts.Force then return {Dismiss = function() end} end
	local th = self.CurrentTheme
	local host = GetNotifyHost()
	local duration = opts.Duration
	if duration == nil then duration = 4 end
	local kinds = {info = th.Accent, success = th.Success, warn = th.Warning, warning = th.Warning, error = th.Danger}
	local accent = kinds[opts.Type or "info"] or th.Accent

	notifyCount = notifyCount + 1
	local wrapper = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1, LayoutOrder = notifyCount, Parent = host,
	})
	local card = Create("Frame", {
		Position = UDim2.new(1, 50, 0, 0), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = th.Surface, ClipsDescendants = true, Parent = wrapper,
	}, {Corner(9), Pad(12, 10, 12, 10), List(6)})
	Stroke(card, th.Stroke)

	local header = Create("Frame", {LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, Parent = card})
	local icon = ResolveIcon(opts.Image or opts.Icon)
	local tx = 0
	if icon then
		Create("ImageLabel", {
			Position = UDim2.fromOffset(0, 1), Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1,
			Image = icon, ImageColor3 = th.Text, Parent = header,
		})
		tx = 24
	end
	Create("TextLabel", {
		Position = UDim2.fromOffset(tx, 0), Size = UDim2.new(1, -tx, 1, 0), BackgroundTransparency = 1,
		Font = FONT_B, TextSize = 13, TextColor3 = th.Text, TextXAlignment = LEFT,
		TextTruncate = Enum.TextTruncate.AtEnd, Text = opts.Title or "Graphite", Parent = header,
	})
	if opts.Content and opts.Content ~= "" then
		Create("TextLabel", {
			LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 14), AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1, Font = FONT, TextSize = 12, TextColor3 = th.SubText,
			TextXAlignment = LEFT, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true,
			Text = opts.Content, Parent = card,
		})
	end

	local active = self._notes
	local dismissed = false
	local function dismiss()
		if dismissed then return end
		dismissed = true
		local i = table.find(active, dismiss)
		if i then table.remove(active, i) end
		local t = Tween(card, {Position = UDim2.new(1, 50, 0, 0)}, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In))
		t.Completed:Once(function() wrapper:Destroy() end)
		Safe(opts.OnClose)
	end

	if type(opts.Actions) == "table" and #opts.Actions > 0 then
		local row = Create("Frame", {
			LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, Parent = card,
		}, {List(6, {FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center})})
		for i, a in ipairs(opts.Actions) do
			local b = Create("TextButton", {
				LayoutOrder = i, Size = UDim2.fromOffset(0, 24), AutomaticSize = Enum.AutomaticSize.X,
				BackgroundColor3 = th.Elevated, AutoButtonColor = false, Font = FONT_M, TextSize = 12,
				TextColor3 = th.Text, Text = a.Name or "OK", Parent = row,
			}, {Corner(5), Pad(10, 0, 10, 0)})
			Stroke(b, th.Stroke)
			b.MouseEnter:Connect(function() Tween(b, {BackgroundColor3 = th.Stroke}) end)
			b.MouseLeave:Connect(function() Tween(b, {BackgroundColor3 = th.Elevated}) end)
			b.MouseButton1Click:Connect(function()
				Safe(a.Callback)
				if a.Dismiss ~= false then dismiss() end
			end)
		end
	end

	if duration > 0 then
		local bar = Create("Frame", {
			LayoutOrder = 4, Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = th.Elevated, BorderSizePixel = 0, Parent = card,
		}, {Pill()})
		local fill = Create("Frame", {
			Size = UDim2.fromScale(1, 1), BackgroundColor3 = accent, BorderSizePixel = 0, Parent = bar,
		}, {Pill()})
		Tween(fill, {Size = UDim2.new(0, 0, 1, 0)}, TweenInfo.new(duration, Enum.EasingStyle.Linear))
		task.delay(duration, dismiss)
	end

	table.insert(active, dismiss)
	if #active > 5 then active[1]() end
	card.InputBegan:Connect(function(input)
		if input.UserInputType == MOUSE1 or input.UserInputType == TOUCH then dismiss() end
	end)
	Tween(card, {Position = UDim2.new(0, 0, 0, 0)}, TweenInfo.new(0.32, Enum.EasingStyle.Quint, Enum.EasingDirection.Out))
	return {Dismiss = dismiss}
end

--══════════════════════════════════════════════════════════════════════
-- SISTEMA DE CLAVE (bloquea hasta validar, como Rayfield)
--══════════════════════════════════════════════════════════════════════
function Graphite:_RunKeySystem(cfg, theme, folder)
	local keys = cfg.Key
	if type(keys) == "string" then keys = {keys} end
	keys = keys or {}
	local keyFile = folder .. "/" .. (cfg.FileName or "Key") .. ".txt"

	local function valid(input)
		input = tostring(input or ""):match("^%s*(.-)%s*$")
		if type(cfg.Verify) == "function" then
			local ok, res = pcall(cfg.Verify, input)
			return ok and res == true
		end
		for _, k in ipairs(keys) do
			if k == input then return true end
		end
		return false
	end

	if cfg.SaveKey ~= false then
		local saved = FS.Read(keyFile)
		if saved and valid(saved) then return true end
	end

	local pg = LocalPlayer:WaitForChild("PlayerGui")
	local gui = Create("ScreenGui", {
		Name = "GraphiteKey", ResetOnSpawn = false, DisplayOrder = 500, IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = pg,
	})
	local dim = Create("Frame", {
		Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.35,
		BorderSizePixel = 0, Parent = gui,
	})
	local card = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(340, 0),
		AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = theme.Background, Parent = dim,
	}, {Corner(12), Pad(20, 18, 20, 18), List(10)})
	Stroke(card, theme.Stroke)

	local function label(order, text, size, font, color)
		return Create("TextLabel", {
			LayoutOrder = order, Size = UDim2.new(1, 0, 0, size + 4), AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1, Font = font, TextSize = size, TextColor3 = color, Text = text,
			TextXAlignment = LEFT, TextWrapped = true, Parent = card,
		})
	end
	label(1, cfg.Title or "Acceso", 18, FONT_B, theme.Text)
	label(2, cfg.Subtitle or "Introduce tu clave", 13, FONT, theme.SubText)
	local box = Create("TextBox", {
		LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = theme.Surface, ClearTextOnFocus = false,
		Text = "", PlaceholderText = "Clave", PlaceholderColor3 = theme.SubText, TextColor3 = theme.Text,
		Font = FONT_M, TextSize = 13, TextXAlignment = LEFT, Parent = card,
	}, {Corner(7), Pad(12, 0, 12, 0)})
	local boxStroke = Stroke(box, theme.Stroke)
	local errLbl = label(4, "", 12, FONT, theme.Danger)
	local btn = Create("TextButton", {
		LayoutOrder = 5, Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = theme.Accent, AutoButtonColor = false,
		Font = FONT_B, TextSize = 13, TextColor3 = theme.AccentText, Text = "Continuar", Parent = card,
	}, {Corner(7)})
	if cfg.Note and cfg.Note ~= "" then label(6, cfg.Note, 11, FONT, theme.SubText) end
	local closeBtn = Create("TextButton", {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 8), Size = UDim2.fromOffset(24, 24),
		BackgroundTransparency = 1, Font = FONT_B, TextSize = 18, TextColor3 = theme.SubText, Text = "×", Parent = card,
	})

	local done, ok, attempts = false, false, 0
	local function submit()
		if valid(box.Text) then
			if cfg.SaveKey ~= false then
				FS.EnsureFolder(folder)
				FS.Write(keyFile, (box.Text:match("^%s*(.-)%s*$")))
			end
			ok, done = true, true
			return
		end
		attempts = attempts + 1
		errLbl.Text = "Clave incorrecta"
		Tween(boxStroke, {Color = theme.Danger})
		task.delay(0.8, function() if boxStroke.Parent then Tween(boxStroke, {Color = theme.Stroke}) end end)
		task.spawn(function()
			for _, x in ipairs({-8, 8, -5, 5, 0}) do
				card.Position = UDim2.new(0.5, x, 0.5, 0)
				task.wait(0.04)
			end
		end)
		if cfg.MaxAttempts and attempts >= cfg.MaxAttempts then done = true end
	end
	btn.MouseButton1Click:Connect(submit)
	box.FocusLost:Connect(function(enter) if enter then submit() end end)
	closeBtn.MouseButton1Click:Connect(function() done = true end)

	repeat task.wait() until done
	gui:Destroy()
	if not ok then coroutine.yield() end -- detiene el script: sin clave no hay interfaz
	return true
end

--══════════════════════════════════════════════════════════════════════
-- VENTANA: infraestructura
--══════════════════════════════════════════════════════════════════════
function Window:_Bind(inst, prop, key)
	inst[prop] = self.Theme[key]
	table.insert(self._bindings, {inst, prop, key})
end

function Window:_Refresh(anchor, fn)
	table.insert(self._refreshers, {anchor, fn})
	fn()
end

function Window:_Hover(row, hit)
	hit.MouseEnter:Connect(function() Tween(row, {BackgroundColor3 = self.Theme.Hover}) end)
	hit.MouseLeave:Connect(function() Tween(row, {BackgroundColor3 = self.Theme.Surface}) end)
end

function Window:_Flag(flag, obj)
	if not flag then return end
	obj.Flag = flag
	self.Flags[flag] = obj
	Graphite.Flags[flag] = obj
end

function Window:_Emit(obj, opts, ...)
	Safe(opts.Callback, ...)
	if obj.Changed then obj.Changed:Fire(...) end
	self.Events.ElementChanged:Fire(obj, ...)
	self:_Changed()
end

function Window:_Changed()
	local cfg = self.Saving
	if self._loading or not (cfg and cfg.Enabled) then return end
	self._saveToken = (self._saveToken or 0) + 1
	local token = self._saveToken
	task.delay(1, function()
		if token == self._saveToken and not self.Destroyed then self:SaveConfig(self.ConfigName, true) end
	end)
end

function Window:_SaveSettings()
	local s = self.Settings
	s.Theme = self.ThemeName
	s.Scale = self._userScale
	s.ToggleKey = self.ToggleKey.Name
	s.Notifications = Graphite.NotificationsEnabled
	FS.EnsureFolder(self.Folder)
	FS.Write(self.Folder .. "/Settings.json", HttpService:JSONEncode(s))
end

function Window:SetTheme(nameOrTable)
	local theme, name
	if type(nameOrTable) == "table" then
		theme = nameOrTable
	else
		theme, name = Graphite.Themes[nameOrTable], nameOrTable
	end
	if not theme then return false end
	for k, v in pairs(Themes.Graphite) do
		if theme[k] == nil then theme[k] = v end
	end
	self.Theme = theme
	self.ThemeName = name or self.ThemeName
	Graphite.CurrentTheme = theme
	for i = #self._bindings, 1, -1 do
		local b = self._bindings[i]
		if b[1].Parent == nil then
			table.remove(self._bindings, i)
		else
			Tween(b[1], {[b[2]] = theme[b[3]]})
		end
	end
	for i = #self._refreshers, 1, -1 do
		local r = self._refreshers[i]
		if r[1].Parent == nil then table.remove(self._refreshers, i) else r[2]() end
	end
	self.Events.Theme:Fire(self.ThemeName, theme)
	return true
end

function Window:GetTheme() return self.Theme, self.ThemeName end

function Window:SetScale(value)
	self._userScale = math.clamp(tonumber(value) or 1, 0.6, 1.4)
	self._applyScale()
end

function Window:SetToggleKey(key)
	local k = ToKeyCode(key)
	if k then self.ToggleKey = k end
end

function Window:Notify(opts) return Graphite:Notify(opts) end

-- Tooltips
function Window:_Tooltip(row, text)
	if type(text) ~= "string" or text == "" then return end
	local tip = self._tip
	local token = 0
	local function place()
		local m = UserInputService:GetMouseLocation() - GuiService:GetGuiInset()
		tip.Position = UDim2.fromOffset(m.X + 14, m.Y + 18)
	end
	row.MouseEnter:Connect(function()
		token = token + 1
		local mine = token
		task.delay(0.45, function()
			if mine ~= token or self.Destroyed then return end
			self._tipLabel.Text = text
			place()
			tip.Visible = true
		end)
	end)
	row.MouseMoved:Connect(function() if tip.Visible then place() end end)
	row.MouseLeave:Connect(function()
		token = token + 1
		tip.Visible = false
	end)
end

-- Búsqueda
function Window:_ApplyEntry(e)
	e.row.Visible = (not e.hidden) and e.matched
end

function Window:_ApplySearch()
	local tab = self.ActiveTab
	if not tab then return end
	local q = self._query
	local any = false
	for _, e in ipairs(tab._entries) do
		e.matched = q == "" or (not e.nosearch and (e.name:find(q, 1, true) ~= nil or e.desc:find(q, 1, true) ~= nil))
		e.row.Visible = (not e.hidden) and e.matched
		if e.row.Visible and not e.nosearch then any = true end
	end
	for _, sec in ipairs(tab._sections) do
		local vis = q == ""
		if not vis then
			for _, e in ipairs(sec._entries) do
				if e.row.Visible then vis = true break end
			end
		end
		sec.Frame.Visible = vis
	end
	self._noResults.Visible = q ~= "" and not any
end

function Window:SetSearchOpen(state)
	if self._searchOpen == state then return end
	self._searchOpen = state
	Tween(self._searchNV, {Value = state and 40 or 0}, EASE_SLOW)
	if state then
		task.delay(0.15, function() if self._searchBox.Parent then self._searchBox:CaptureFocus() end end)
	else
		self._searchBox.Text = ""
		self._query = ""
		self:_ApplySearch()
	end
end

--══════════════════════════════════════════════════════════════════════
-- CONFIGURACIONES (perfiles)
--══════════════════════════════════════════════════════════════════════
function Window:_ConfigPath(name)
	return self.Folder .. "/Configs/" .. name .. ".json"
end

function Window:ExportConfig()
	local data = {}
	for flag, obj in pairs(self.Flags) do
		if obj._Export then
			local ok, v = pcall(obj._Export, obj)
			if ok and v ~= nil then data[flag] = v end
		end
	end
	return HttpService:JSONEncode(data)
end

function Window:ImportConfig(json)
	local ok, decoded = pcall(function() return HttpService:JSONDecode(json) end)
	if not ok or type(decoded) ~= "table" then return false, "JSON inválido" end
	self._loading = true
	for flag, value in pairs(decoded) do
		local obj = self.Flags[flag]
		if obj and obj._Import then pcall(obj._Import, obj, value) end
	end
	self._loading = false
	return true
end

function Window:SaveConfig(name, silent)
	name = SanitizeName(name) or self.ConfigName
	FS.EnsureFolder(self.Folder .. "/Configs")
	FS.Write(self:_ConfigPath(name), self:ExportConfig())
	self.ConfigName = name
	return true
end

function Window:LoadConfig(name)
	name = SanitizeName(name) or self.Settings.AutoLoad or self.ConfigName
	local raw = FS.Read(self:_ConfigPath(name))
	if not raw then return false, "no existe el perfil '" .. tostring(name) .. "'" end
	local ok, err = self:ImportConfig(raw)
	if ok then self.ConfigName = name end
	return ok, err
end
Window.LoadConfiguration = Window.LoadConfig

function Window:DeleteConfig(name)
	name = SanitizeName(name)
	if not name then return false end
	FS.Delete(self:_ConfigPath(name))
	if self.Settings.AutoLoad == name then
		self.Settings.AutoLoad = nil
		self:_SaveSettings()
	end
	return true
end

function Window:ListConfigs()
	return FS.List(self.Folder .. "/Configs", "json")
end

