local MOUSE1, TOUCH, MOVE = Enum.UserInputType.MouseButton1, Enum.UserInputType.Touch, Enum.UserInputType.MouseMovement
local FONT, FONT_M, FONT_B = Enum.Font.Gotham, Enum.Font.GothamMedium, Enum.Font.GothamBold
local LEFT, RIGHT, CENTER = Enum.TextXAlignment.Left, Enum.TextXAlignment.Right, Enum.TextXAlignment.Center
local EASE = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local EASE_SLOW = TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local INSTANT = TweenInfo.new(0)

local function Create(class, props, children)
	local inst = Instance.new(class)
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then parent = v else inst[k] = v end
	end
	for _, child in ipairs(children or {}) do child.Parent = inst end
	inst.Parent = parent
	return inst
end

local function Corner(r) return Create("UICorner", {CornerRadius = UDim.new(0, r)}) end
local function Pill() return Create("UICorner", {CornerRadius = UDim.new(1, 0)}) end
local function Pad(l, t, r, b)
	return Create("UIPadding", {
		PaddingLeft = UDim.new(0, l), PaddingTop = UDim.new(0, t),
		PaddingRight = UDim.new(0, r), PaddingBottom = UDim.new(0, b),
	})
end
-- IMPORTANTE: en TextLabel/TextButton/TextBox el UIStroke debe ir en modo Border
local function Stroke(parent, color, thickness)
	local s = Create("UIStroke", {ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Thickness = thickness or 1})
	if color then s.Color = color end
	s.Parent = parent
	return s
end
local function List(padding, props)
	local l = Create("UIListLayout", {Padding = UDim.new(0, padding or 0), SortOrder = Enum.SortOrder.LayoutOrder})
	for k, v in pairs(props or {}) do l[k] = v end
	return l
end

local function Tween(inst, props, info)
	local t = TweenService:Create(inst, info or EASE, props)
	t:Play()
	return t
end

local function Safe(cb, ...)
	if type(cb) ~= "function" then return end
	local ok, err = pcall(cb, ...)
	if not ok then warn("[Graphite] Error en callback: " .. tostring(err)) end
end

local function Global(name)
	local ok, v = pcall(function() return getfenv()[name] end)
	return ok and v or nil
end

local function Pick(opts, ...)
	for _, k in ipairs({...}) do
		if opts[k] ~= nil then return opts[k] end
	end
	return nil
end

local function Copy(v)
	if type(v) == "table" then return table.clone(v) end
	return v
end

local function ToHex(c)
	return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

local function SanitizeName(s)
	s = tostring(s or ""):gsub("[^%w%-_ ]", "")
	s = s:match("^%s*(.-)%s*$")
	if s == "" then return nil end
	return s
end

local function ToKeyCode(k)
	if typeof(k) == "EnumItem" then return k end
	if type(k) == "string" and k ~= "" then
		local ok, v = pcall(function() return Enum.KeyCode[k] end)
		if ok then return v end
	end
	return nil
end

--── Maid ───────────────────────────────────────────────────────────────
local Maid = {}
Maid.__index = Maid
function Maid.new() return setmetatable({_tasks = {}}, Maid) end
function Maid:Give(task)
	table.insert(self._tasks, task)
	return task
end
function Maid:Clean()
	for _, t in ipairs(self._tasks) do
		local ty = typeof(t)
		if ty == "RBXScriptConnection" then t:Disconnect()
		elseif ty == "Instance" then t:Destroy()
		elseif ty == "function" then pcall(t) end
	end
	table.clear(self._tasks)
end

--── Signal ─────────────────────────────────────────────────────────────
local Signal = {}
Signal.__index = Signal
function Signal.new() return setmetatable({_h = {}}, Signal) end
function Signal:Connect(fn)
	local conn = {Connected = true, _fn = fn}
	function conn:Disconnect() self.Connected = false end
	table.insert(self._h, conn)
	return conn
end
function Signal:Once(fn)
	local conn
	conn = self:Connect(function(...)
		conn:Disconnect()
		fn(...)
	end)
	return conn
end
function Signal:Wait()
	local co = coroutine.running()
	self:Once(function(...) task.spawn(co, ...) end)
	return coroutine.yield()
end
function Signal:Fire(...)
	for i = #self._h, 1, -1 do
		if not self._h[i].Connected then table.remove(self._h, i) end
	end
	for _, c in ipairs(table.clone(self._h)) do
		if c.Connected then task.spawn(c._fn, ...) end
	end
end

--── Archivos (con respaldo en memoria si no hay writefile) ─────────────
local FS = {mem = {}}
function FS.IsPersistent() return Global("writefile") ~= nil and Global("readfile") ~= nil end
function FS.EnsureFolder(path)
	local isf, mk = Global("isfolder"), Global("makefolder")
	if not (isf and mk) then return end
	local acc = ""
	for seg in tostring(path):gmatch("[^/]+") do
		acc = acc == "" and seg or (acc .. "/" .. seg)
		pcall(function() if not isf(acc) then mk(acc) end end)
	end
end
function FS.Write(path, content)
	local w = Global("writefile")
	if w then
		local ok = pcall(w, path, content)
		if ok then return true end
	end
	FS.mem[path] = content
	return true
end
function FS.Read(path)
	local r, isf = Global("readfile"), Global("isfile")
	if r and isf then
		local ok, exists = pcall(isf, path)
		if ok and exists then
			local ok2, data = pcall(r, path)
			if ok2 then return data end
		end
	end
	return FS.mem[path]
end
function FS.Delete(path)
	local d = Global("delfile")
	if d then pcall(d, path) end
	FS.mem[path] = nil
end
function FS.List(folder, ext)
	local names, seen = {}, {}
	local function add(path)
		local n = path:match("([^/\\]+)%." .. ext .. "$")
		if n and not seen[n] then
			seen[n] = true
			table.insert(names, n)
		end
	end
	local lf = Global("listfiles")
	if lf then
		local ok, res = pcall(lf, folder)
		if ok and type(res) == "table" then
			for _, p in ipairs(res) do add(p) end
		end
	end
	for p in pairs(FS.mem) do
		if p:sub(1, #folder + 1) == folder .. "/" then add(p) end
	end
	table.sort(names)
	return names
end

--── Arrastre de valores (sliders, selectores). Devuelve limpieza ───────
local function TrackDrag(hit, onMove, scroller, maid)
	local active = false
	local function release()
		if active then
			active = false
			if scroller then scroller.ScrollingEnabled = true end
		end
	end
	local conns = {
		hit.InputBegan:Connect(function(input)
			if input.UserInputType == MOUSE1 or input.UserInputType == TOUCH then
				active = true
				if scroller then scroller.ScrollingEnabled = false end
				onMove(input.Position)
			end
		end),
		UserInputService.InputChanged:Connect(function(input)
			if active and (input.UserInputType == MOVE or input.UserInputType == TOUCH) then
				onMove(input.Position)
			end
		end),
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == MOUSE1 or input.UserInputType == TOUCH then release() end
		end),
	}
	local function cleanup()
		release()
		for _, c in ipairs(conns) do c:Disconnect() end
	end
	maid:Give(cleanup)
	return cleanup
end

local function MakeDraggable(handle, target, maid)
	local dragging, startInput, startPos = false, nil, nil
	maid:Give(handle.InputBegan:Connect(function(input)
		if input.UserInputType == MOUSE1 or input.UserInputType == TOUCH then
			dragging = true
			startInput = input.Position
			startPos = target.Position
		end
	end))
	maid:Give(UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == MOVE or input.UserInputType == TOUCH) then
			local d = input.Position - startInput
			target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			-- mantener la barra superior dentro de la pantalla
			local gui = target:FindFirstAncestorOfClass("ScreenGui")
			if gui then
				local gs, ap, as = gui.AbsoluteSize, target.AbsolutePosition, target.AbsoluteSize
				local dx, dy = 0, 0
				if ap.X + as.X < 90 then dx = 90 - (ap.X + as.X) elseif ap.X > gs.X - 90 then dx = (gs.X - 90) - ap.X end
				if ap.Y < 0 then dy = -ap.Y elseif ap.Y > gs.Y - 44 then dy = (gs.Y - 44) - ap.Y end
				if dx ~= 0 or dy ~= 0 then target.Position = target.Position + UDim2.fromOffset(dx, dy) end
			end
		end
	end))
	maid:Give(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == MOUSE1 or input.UserInputType == TOUCH then dragging = false end
	end))
end

