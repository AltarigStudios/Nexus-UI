-- ELEMENTO: Segmented (opciones en línea)
--══════════════════════════════════════════════════════════════════════
function Elements:CreateSegmented(opts)
	opts = opts or {}
	local win = self.Window
	local options = table.clone(opts.Options or {})
	local row, title, headerH = self:_Row(opts, 40)
	local value = Pick(opts, "Default", "CurrentOption")
	if type(value) == "table" then value = value[1] end
	if value == nil then value = options[1] end

	local holder = Create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0, headerH / 2), Size = UDim2.fromOffset(0, 28),
		AutomaticSize = Enum.AutomaticSize.X, Parent = row,
	}, {Corner(7), Pad(2, 2, 2, 2), List(2, {FillDirection = Enum.FillDirection.Horizontal})})
	local hStroke = Stroke(holder)
	win:_Bind(holder, "BackgroundColor3", "Elevated")
	win:_Bind(hStroke, "Color", "Stroke")

	local buttons = {}
	local obj = {Type = "Segmented", Value = value}
	local function paint()
		local th = win.Theme
		for opt, b in pairs(buttons) do
			local on = opt == value
			Tween(b, {BackgroundColor3 = th.Accent, BackgroundTransparency = on and 0 or 1, TextColor3 = on and th.AccentText or th.SubText})
		end
	end
	for i, opt in ipairs(options) do
		local b = Create("TextButton", {
			LayoutOrder = i, Size = UDim2.fromOffset(0, 24), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1,
			AutoButtonColor = false, Font = FONT_M, TextSize = 12, Text = tostring(opt), Parent = holder,
		}, {Corner(5), Pad(10, 0, 10, 0)})
		buttons[opt] = b
		b.MouseButton1Click:Connect(function() obj:Set(opt) end)
	end
	win:_Refresh(row, paint)

	function obj:Set(v, silent)
		if not table.find(options, v) then return end
		local changed = v ~= value
		value = v
		self.Value = v
		paint()
		if changed and not silent then win:_Emit(self, opts, v) end
	end
	function obj:_Export() return value end
	function obj:_Import(data) self:Set(data) end
	return self:_Finish(obj, row, opts)
end

--══════════════════════════════════════════════════════════════════════
-- ELEMENTO: Keybind
--══════════════════════════════════════════════════════════════════════
function Elements:CreateKeybind(opts)
	opts = opts or {}
	local win = self.Window
	local row, title, headerH = self:_Row(opts, 40)
	local key = ToKeyCode(Pick(opts, "Default", "CurrentKeybind"))
	local hold = Pick(opts, "Hold", "HoldToInteract") == true
	local listening = false
	local btn = Create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0, headerH / 2), Size = UDim2.fromOffset(90, 26),
		AutoButtonColor = false, Font = FONT_M, TextSize = 12, Parent = row,
	}, {Corner(6)})
	local stroke = Stroke(btn)
	win:_Bind(btn, "BackgroundColor3", "Elevated")
	win:_Bind(btn, "TextColor3", "Text")
	win:_Bind(stroke, "Color", "Stroke")

	local obj = {Type = "Keybind", Value = key, KeyChanged = Signal.new()}
	local function render()
		btn.Text = listening and "..." or (key and key.Name or "Ninguna")
		Tween(stroke, {Color = listening and win.Theme.Accent or win.Theme.Stroke})
	end
	render()

	btn.MouseButton1Click:Connect(function()
		listening = true
		render()
	end)
	local conns = {
		UserInputService.InputBegan:Connect(function(input, processed)
			if listening then
				if input.UserInputType == Enum.UserInputType.Keyboard then
					listening = false
					if input.KeyCode == Enum.KeyCode.Backspace then
						key = nil
					elseif input.KeyCode ~= Enum.KeyCode.Escape then
						key = input.KeyCode
					end
					obj.Value = key
					render()
					obj.KeyChanged:Fire(key)
					Safe(opts.OnChange, key)
					win:_Changed()
				end
				return
			end
			if processed or not key or input.KeyCode ~= key then return end
			Safe(opts.Callback, hold and true or key)
			obj.Changed:Fire(hold and true or key)
		end),
		UserInputService.InputEnded:Connect(function(input)
			if hold and key and input.KeyCode == key then
				Safe(opts.Callback, false)
				obj.Changed:Fire(false)
			end
		end),
	}
	for _, c in ipairs(conns) do win.Maid:Give(c) end

	function obj:Set(k, silent)
		key = ToKeyCode(k)
		self.Value = key
		render()
		if not silent then
			self.KeyChanged:Fire(key)
			Safe(opts.OnChange, key)
			win:_Changed()
		end
	end
	function obj:_Export() return key and key.Name or "" end
	function obj:_Import(data) self:Set(data) end
	return self:_Finish(obj, row, opts, function()
		for _, c in ipairs(conns) do c:Disconnect() end
	end)
end

