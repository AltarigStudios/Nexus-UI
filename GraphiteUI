--══════════════════════════════════════════════════════════════════════
-- ELEMENTO: Dropdown (simple / múltiple / con búsqueda)
--══════════════════════════════════════════════════════════════════════
function Elements:CreateDropdown(opts)
	opts = opts or {}
	local win = self.Window
	local multi = Pick(opts, "Multi", "MultipleOptions") == true
	local options = table.clone(opts.Options or {})
	local maxVisible = opts.MaxVisible or 5
	local row, title, headerH = self:_Row(opts, 40)

	local selected, single = {}, nil
	local function load(def)
		if multi then
			selected = {}
			for _, v in ipairs(type(def) == "table" and def or {}) do selected[v] = true end
		else
			single = type(def) == "table" and def[1] or def
		end
	end
	load(Pick(opts, "Default", "CurrentOption"))
	local function getValue()
		if multi then
			local out = {}
			for _, o in ipairs(options) do
				if selected[o] then table.insert(out, o) end
			end
			return out
		end
		return single
	end

	local head = Create("TextButton", {
		Size = UDim2.new(1, 0, 0, headerH), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 2, Parent = row,
	})
	local valueLabel = Create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -32, 0, headerH / 2), Size = UDim2.new(0.4, 0, 0, 20),
		BackgroundTransparency = 1, Font = FONT_M, TextSize = 12, TextXAlignment = RIGHT,
		TextTruncate = Enum.TextTruncate.AtEnd, Parent = row,
	})
	win:_Bind(valueLabel, "TextColor3", "SubText")
	local arrow = Create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0, headerH / 2), Size = UDim2.fromOffset(16, 16),
		BackgroundTransparency = 1, Font = FONT_B, TextSize = 18, Text = "›", Parent = row,
	})
	win:_Bind(arrow, "TextColor3", "SubText")
	win:_Hover(row, head)

	local searchable = opts.Searchable == true or (opts.Searchable ~= false and #options > 8)
	local searchH = searchable and 32 or 0
	local searchBox
	if searchable then
		searchBox = Create("TextBox", {
			Position = UDim2.new(0, 12, 0, headerH + 4), Size = UDim2.new(1, -24, 0, 24), ClearTextOnFocus = false,
			Text = "", PlaceholderText = "Buscar...", Font = FONT, TextSize = 12, TextXAlignment = LEFT, Parent = row,
		}, {Corner(6), Pad(9, 0, 9, 0)})
		win:_Bind(searchBox, "BackgroundColor3", "Elevated")
		win:_Bind(searchBox, "TextColor3", "Text")
		win:_Bind(searchBox, "PlaceholderColor3", "SubText")
	end
	local scroll = Create("ScrollingFrame", {
		Position = UDim2.new(0, 6, 0, headerH + searchH + 4), Size = UDim2.new(1, -12, 0, 0), BackgroundTransparency = 1,
		BorderSizePixel = 0, ScrollBarThickness = 2, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Parent = row,
	}, {List(2)})
	win:_Bind(scroll, "ScrollBarImageColor3", "Stroke")

	local obj = {Type = "Dropdown"}
	local buttons, isOpen = {}, false

	local function paint()
		local th = win.Theme
		for opt, b in pairs(buttons) do
			local on = (multi and selected[opt]) or (not multi and single == opt)
			b.btn.BackgroundColor3 = th.Elevated
			Tween(b.btn, {BackgroundTransparency = on and 0 or 1})
			b.label.TextColor3 = on and th.Text or th.SubText
			b.dot.BackgroundColor3 = th.Accent
			b.dot.Visible = on and true or false
		end
		local v = getValue()
		if multi then
			valueLabel.Text = #v > 0 and table.concat(v, ", ") or "Ninguno"
		else
			valueLabel.Text = v ~= nil and tostring(v) or "Seleccionar"
		end
	end
	win:_Refresh(row, paint)

	local function setOpen(state)
		isOpen = state
		local scrollH = math.max(0, math.min(#options, maxVisible) * 26 - 2)
		scroll.Size = UDim2.new(1, -12, 0, scrollH)
		local total = headerH + searchH + 4 + scrollH + 8
		Tween(row, {Size = UDim2.new(1, 0, 0, state and total or headerH)}, EASE_SLOW)
		Tween(arrow, {Rotation = state and 90 or 0})
	end

	local function choose(opt)
		if multi then selected[opt] = not selected[opt] or nil else single = opt end
		paint()
		obj.Value = getValue()
		win:_Emit(obj, opts, obj.Value)
		if not multi then setOpen(false) end
	end

	local function rebuild()
		for _, b in pairs(buttons) do b.btn:Destroy() end
		buttons = {}
		for i, opt in ipairs(options) do
			local btn = Create("TextButton", {
				Name = tostring(opt), LayoutOrder = i, Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1,
				Text = "", AutoButtonColor = false, Parent = scroll,
			}, {Corner(5)})
			local label = Create("TextLabel", {
				BackgroundTransparency = 1, Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -24, 1, 0), Font = FONT,
				TextSize = 12, Text = tostring(opt), TextXAlignment = LEFT, TextTruncate = Enum.TextTruncate.AtEnd, Parent = btn,
			})
			local dot = Create("Frame", {
				AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(6, 6), Parent = btn,
			}, {Pill()})
			btn.MouseButton1Click:Connect(function() choose(opt) end)
			buttons[opt] = {btn = btn, label = label, dot = dot}
		end
		paint()
	end
	rebuild()
	obj.Value = getValue()

	if searchBox then
		searchBox:GetPropertyChangedSignal("Text"):Connect(function()
			local q = searchBox.Text:lower()
			for opt, b in pairs(buttons) do
				b.btn.Visible = q == "" or tostring(opt):lower():find(q, 1, true) ~= nil
			end
		end)
	end
	head.MouseButton1Click:Connect(function() setOpen(not isOpen) end)

	function obj:Set(v, silent)
		load(v)
		paint()
		self.Value = getValue()
		if not silent then win:_Emit(self, opts, self.Value) end
	end
	function obj:Refresh(newOptions)
		options = table.clone(newOptions or {})
		if multi then
			for k in pairs(selected) do
				if not table.find(options, k) then selected[k] = nil end
			end
		elseif single ~= nil and not table.find(options, single) then
			single = nil
		end
		rebuild()
		self.Value = getValue()
		if isOpen then setOpen(true) end
	end
	obj.SetOptions = obj.Refresh
	function obj:_Export() return getValue() end
	function obj:_Import(data) self:Set(data) end
	return self:_Finish(obj, row, opts)
end

