function Elements:_NextOrder()
	self._order = (self._order or 0) + 1
	return self._order
end

function Elements:_Register(row, name, desc, nosearch)
	local entry = {
		row = row, name = tostring(name or ""):lower(), desc = tostring(desc or ""):lower(),
		hidden = false, matched = true, nosearch = nosearch,
	}
	local tab = self._tab
	table.insert(tab._entries, entry)
	if self._entries ~= tab._entries then table.insert(self._entries, entry) end
	return entry
end

function Elements:_Row(opts, baseHeight)
	local win = self.Window
	local desc = opts.Description
	local hasDesc = type(desc) == "string" and desc ~= ""
	local headerH = baseHeight + (hasDesc and 14 or 0)
	local row = Create("Frame", {
		Name = tostring(opts.Name or "Element"), Size = UDim2.new(1, 0, 0, headerH),
		LayoutOrder = self:_NextOrder(), ClipsDescendants = true, Parent = self.Container,
	}, {Corner(7)})
	local stroke = Stroke(row)
	win:_Bind(row, "BackgroundColor3", "Surface")
	win:_Bind(stroke, "Color", "Stroke")

	local title = Create("TextLabel", {
		Name = "Title", BackgroundTransparency = 1, Position = UDim2.fromOffset(14, hasDesc and 7 or 0),
		Size = UDim2.new(0.5, -14, 0, hasDesc and 18 or headerH), Font = FONT_M, TextSize = 13,
		Text = tostring(opts.Name or "Element"), TextXAlignment = LEFT, TextTruncate = Enum.TextTruncate.AtEnd, Parent = row,
	})
	win:_Bind(title, "TextColor3", "Text")
	if hasDesc then
		local d = Create("TextLabel", {
			Name = "Desc", BackgroundTransparency = 1, Position = UDim2.fromOffset(14, 26), Size = UDim2.new(0.5, -14, 0, 14),
			Font = FONT, TextSize = 11, Text = desc, TextXAlignment = LEFT, TextTruncate = Enum.TextTruncate.AtEnd, Parent = row,
		})
		win:_Bind(d, "TextColor3", "SubText")
	end
	win:_Tooltip(row, opts.Tooltip)
	return row, title, headerH
end

function Elements:_Finish(obj, row, opts, cleanup)
	local win = self.Window
	local tab = self._tab
	local container = self
	obj.Row = row
	obj.Changed = obj.Changed or Signal.new()
	local entry = self:_Register(row, opts.Name, opts.Description)
	obj._entry = entry
	table.insert(tab._objects, obj)
	if obj.Value ~= nil then obj._default = Copy(obj.Value) end
	if obj.Get == nil then function obj:Get() return self.Value end end

	function obj:SetVisible(v)
		entry.hidden = not v
		win:_ApplyEntry(entry)
	end
	function obj:SetName(text)
		local lbl = row:FindFirstChild("Title")
		if lbl then lbl.Text = tostring(text) end
		entry.name = tostring(text):lower()
	end
	function obj:Reset()
		if self._default ~= nil and self.Set then self:Set(Copy(self._default)) end
	end
	function obj:Lock()
		if row:FindFirstChild("Lock") then return end
		local ov = Create("TextButton", {
			Name = "Lock", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 0.4, Text = "",
			AutoButtonColor = false, ZIndex = 50, Parent = row,
		}, {Corner(7)})
		win:_Bind(ov, "BackgroundColor3", "Background")
	end
	function obj:Unlock()
		local ov = row:FindFirstChild("Lock")
		if ov then ov:Destroy() end
	end
	function obj:Destroy()
		if self._destroyed then return end
		self._destroyed = true
		if cleanup then cleanup() end
		if self.Flag then
			if win.Flags[self.Flag] == self then win.Flags[self.Flag] = nil end
			if Graphite.Flags[self.Flag] == self then Graphite.Flags[self.Flag] = nil end
		end
		local i = table.find(tab._entries, entry)
		if i then table.remove(tab._entries, i) end
		if container._entries ~= tab._entries then
			local j = table.find(container._entries, entry)
			if j then table.remove(container._entries, j) end
		end
		local k = table.find(tab._objects, self)
		if k then table.remove(tab._objects, k) end
		row:Destroy()
	end
	win:_Flag(opts.Flag, obj)
	return obj
end

